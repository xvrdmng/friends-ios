<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El dominio asociado es toolazy.cl (dominio registrable padre), no
	     friends-api.toolazy.cl: así la passkey vale para cualquier subdominio futuro.
	     Requiere servir el AASA en https://toolazy.cl/.well-known/... -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:toolazy.cl</string>
		<string>applinks:friends-api.toolazy.cl</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
