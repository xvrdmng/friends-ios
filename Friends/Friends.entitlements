<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El dominio asociado es friends-api.toolazy.cl: el mismo host del API, que
	     sirve el AASA en https://friends-api.toolazy.cl/.well-known/... -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:friends-api.toolazy.cl?mode=developer</string>
		<string>applinks:friends-api.toolazy.cl?mode=developer</string>
	</array>
	<!-- Sandbox de APNs. La build que se sube usa Friends.Release.entitlements,
	     con "production": un token de un entorno no vale en el otro. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
